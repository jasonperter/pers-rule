[URL Rewrite]
^https?:\/\/api-htp\.beizi\.biz\/mb\/sdk0\/json(?:\?|$) - reject-200
^https?:\/\/adservice\.sigmob\.cn\/(?:hb\/v2\/ad|ad\/v4)(?:\?|$) - reject-200
^https?:\/\/tm\.sigmob\.cn\/(?:waterfall\/v1|strategy\/v6)(?:\?|$) - reject-200
^https?:\/\/(?:mi|v2mi)\.gdt\.qq\.com\/(?:gdt_mview\.fcg|server_bidding2)(?:\?|$) - reject-200

[Script]
hbe-lite = type=http-response, pattern=^https:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/(?:api|secretkey), requires-body=1, max-size=3145728, script-path=https://raw.githubusercontent.com/jasonperter/pers-rule/refs/heads/main/js/haluo.js

[MITM]
hostname = %APPEND% api.hellobike.com, marketingapi.hellobike.com, entertainment.hellobike.com, api-htp.beizi.biz, adservice.sigmob.cn, tm.sigmob.cn, mi.gdt.qq.com, v2mi.gdt.qq.com, resource.51downapp.cn
